# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Public site URL, used for metadata (Open Graph, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# "production" enables search-engine indexing (robots.ts). Anything else
# (e.g. "preview", "development") keeps the site out of search results —
# useful while the real content/branding is still being finalized.
NEXT_PUBLIC_ENV=development

# --- Reservations (not wired up yet, placeholders for the next phase) ---
# WhatsApp number in E.164 format, no "+", used for wa.me reservation links.
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
# Reservations contact email, used for the "email" reservation channel.
NEXT_PUBLIC_RESERVATIONS_EMAIL=hola@ponlounge.co

# --- Future backend integration ---
# Base URL for the real availability/reservations API, once it exists.
# Until then, the app can fall back to a local mock (see docs in README).
# RESERVATIONS_API_URL=
