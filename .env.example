# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Public site URL, used for metadata (Open Graph, sitemap, robots).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# "production" enables search-engine indexing (robots.ts). Anything else
# (e.g. "preview", "development") keeps the site out of search results —
# useful while the real content/branding is still being finalized.
NEXT_PUBLIC_ENV=development

# --- Contact details (shown across the site + used for reservations) ---
# WhatsApp number in E.164 format, no "+", used for wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
# Same number, formatted for display.
NEXT_PUBLIC_PHONE_DISPLAY=+57 300 000 0000
# Reservations contact email — used for the "email" fallback channel AND as
# the reply-to a customer sees; automatic confirmations are sent by Resend
# (see RESEND_API_KEY below), not from this address, until a domain is
# verified in Resend.
NEXT_PUBLIC_RESERVATIONS_EMAIL=hola@ponlounge.co

# --- Social links (shown in the footer) ---
# Leave unset until the client shares the real handles — the footer icon
# only renders once its URL is set, rather than linking to "#".
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Database (automatic reservations) ---
# Postgres connection string. Get this by adding "Postgres" storage (Neon
# integration) to this project in the Vercel dashboard, then either:
#   - running `vercel env pull .env.local` locally, or
#   - copying it from Project Settings > Environment Variables.
# Without this, reservations still book automatically — they're just
# stored in a local, file-simulated database (.data/local-reservations.json)
# instead of real Postgres. See README > "Reservations" for details.
DATABASE_URL=

# --- Email (automatic reservation confirmations) ---
# Resend API key (resend.com) with "Sending access". Without it, bookings
# still save to the database — the confirmation email is just skipped (and
# logged as an error server-side).
RESEND_API_KEY=
